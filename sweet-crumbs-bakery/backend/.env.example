# -------------------------------------------------------
# .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to GitHub!
# -------------------------------------------------------

# A long random string used to sign tokens. Change this!
SECRET_KEY=change-this-to-a-long-random-secret-key

# SQLite database file path (relative to backend folder)
DATABASE_URL=sqlite:///bakery.db

# The frontend origin allowed to call this API (for CORS)
# During local development use your Live Server address:
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Port the Flask server will run on (default: 5000)
PORT=5000
